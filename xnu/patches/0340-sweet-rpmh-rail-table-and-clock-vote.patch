+/*
+ * Rails this helper is allowed to vote for, and the window each one accepts.
+ *
+ * The first revision of this file served a single caller (sweet_touch.c, "ldoc11"
+ * at 3200 mV) and enforced that with a strcmp().  peach-bt needs seven more, so the
+ * policy is a table now.  Windows are the min/max from canoe_base.dts's
+ * rpmh-regulator-* nodes, converted from uV to mV; the vote voltage is the node's
+ * init value.
+ *
+ *   S2J_E1  pmh0104_s2    min  500 max 1100   init  852  (dig, aon, rfa0p75)
+ *   S7F_E0  pmh0110_f_s7  min 1224 max 1372   init 1256  (bt-vdd-rfa1p25)
+ *   S8F_E0  pmh0110_f_s8  min 1800 max 2000   init 1857  (bt-vdd-rfa1p8)
+ *   L2G_E0  pmh0110_g_l2  min=max 1800        init 1800  (bt-vdd18-aon)
+ *   L3G_E0  pmh0110_g_l3  min=max 1200        init 1200  (bt-vdd12-io)
+ *   S1J_E1  pmh0104_s1    min  400 max 1000   init  852  (bt-vdd-wlan-aon)
+ *   L6K_E1  pmr735d_l6    min 1700 max 2000   init 1700  (bt-ant-ldo)
+ *
+ * The _E0/_E1 suffix is part of the cmd-db key, not decoration: rh_lookup() hashes
+ * the first eight bytes of the name and cmd-db stores the suffixed form.
+ */
+struct rh_rail {
+	const char *res;
+	unsigned min_mv;
+	unsigned max_mv;
+};
+
+static const struct rh_rail rh_rails[] = {
+	/* touch panel; exactly the arguments sweet_touch.c already passes */
+	{ "ldoc11",  2950, 3400 },
+	/* Bluetooth, in btpower.ko's bring-up order */
+	{ "S2J_E1",   500, 1100 },
+	{ "S7F_E0",  1224, 1372 },
+	{ "S8F_E0",  1800, 2000 },
+	{ "L2G_E0",  1800, 1800 },
+	{ "L3G_E0",  1200, 1200 },
+	{ "S1J_E1",   400, 1000 },
+	{ "L6K_E1",  1700, 2000 },
+};
