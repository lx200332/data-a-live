+/*
+ * The clock vote.  peach-bt's dts names one clock, "bt_rf_clk1", whose
+ * provider is rpmhcc (canoe_base.dts __symbols__: rpmhcc =
+ * ".../rsc@18900000/drv@2/clock-controller", #clock-cells = 1).  Index 6 of
+ * that provider is C1A_E0: clk-rpmh.c has DEFINE_CLK_RPMH_VRM(clk1, _a1_e0,
+ * "C1A_E0", 1), and Android's clk_summary shows the matching row
+ * "c1a_e0 ... 76800000 ... hardware enable Y".  That 76.8 MHz reference is
+ * what the SoC needs before it will drive its BT TX pad at all.
+ */
+int
+sweet_rpmh_clk_enable(const char *res)
+{
+	if (!res || !res[0]) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, &address);
+	}
+	if (!error) {
+		error = rh_send_clk(address);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: clock enable %s failed errno=%d\n", res, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
